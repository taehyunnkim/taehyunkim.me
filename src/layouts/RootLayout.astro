---
import '@/global.css';
import Footer from '@/components/layout/Footer';
const { title } = Astro.props;

// Generate build time dynamically
const buildTime = new Date().toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="page-content">
			<slot />
		</div>

		<div class="mobile-overlay" role="alertdialog" aria-live="polite">
			<div class="mobile-overlay-card">
				<h2>Mobile view in progress</h2>
				<p>
					This site is still being optimized for smaller screens.
					For the best experience, please visit on a screen at least 1100px wide.
				</p>
			</div>
		</div>

		<Footer buildTime={buildTime} client:load />
	</body>
</html>

<style>
	.mobile-overlay {
		display: none;
	}

	@media (max-width: 1100px) {
		body {
			display: flex;
			flex-direction: column;
			min-height: 100vh;
		}

		.page-content {
			display: none;
		}

		.mobile-overlay {
			display: flex;
			flex: 1;
			align-items: center;
			justify-content: center;
			padding: 24px;
		}

		.mobile-overlay-card {
			max-width: 400px;
			background: var(--white, #fff);
			border-radius: var(--radius, 12px);
			padding: 32px 28px;
			text-align: center;
			box-shadow: rgba(0, 0, 0, 0.2) 0px 8px 24px;
		}

		.mobile-overlay-card h2 {
			font-family: var(--font-serif);
			font-size: 22px;
			font-weight: 600;
			color: var(--black, #171717);
			margin: 0 0 12px 0;
		}

		.mobile-overlay-card p {
			font-size: 15px;
			line-height: 1.6;
			color: #666;
			margin: 0;
		}
	}
</style>
